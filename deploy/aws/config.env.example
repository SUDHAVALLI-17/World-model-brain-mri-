# Copy to config.env and edit.  cp config.env.example config.env
NAME=brainwm                    # prefix for every AWS resource (lower case, letters/digits/-)
REGION=ap-south-1               # Mumbai: keeps uploads in India
INSTANCE_TYPE=t3.large          # 2 vCPU, 8 GB RAM; about $0.09/hour on demand

# HTTPS. With a domain name you own (A record -> the server's IP) you get a free Let's Encrypt
# certificate. Leave DOMAIN empty to use the server's IP with a self-signed certificate
# (works, but browsers show a warning).
DOMAIN=
TLS_EMAIL=                      # needed only with DOMAIN (Let's Encrypt contact)

ALLOWED_CIDR=0.0.0.0/0          # who may reach port 443; e.g. your college's public range x.x.x.x/24
ALLOCATE_EIP=0                  # 1 = fixed public IP (about $3.6/month, also while stopped)
STORE_UPLOADS=0                 # 1 = keep KMS-encrypted copies of uploads in S3 (off: nothing is stored)

ALERT_EMAIL=you@example.com     # budget alert recipient
MONTHLY_BUDGET_USD=20

SECRETS_JSON=../secrets.json    # made with: python -m app.security make-secrets --out deploy/secrets.json
